choice
    prompt "platform"
    default PLATFORM_NUTTX
    config PLATFORM_NUTTX
        bool "nuttx"
endchoice

config BOARD_PLATFORM
    string
    default "nuttx" if PLATFORM_NUTTX

config BOARD_TOOLCHAIN
    string "Toolchain"
    default ""

config BOARD_ARCHITECTURE
    string "Architecture"
    default ""

config NUTTX_CONFIG
    string "nuttx defconfig"
    default "nsh" if PLATFORM_NUTTX

menu "Tarox modules"

config MODULES_LED_DEMO
    bool "led_demo built-in app"
    default n
    help
      Builds src/modules/led_demo when enabled in this board .taroxconfig.

endmenu