choice
    prompt "platform"
    default PLATFORM_NUTTX
    config PLATFORM_NUTTX
        bool "nuttx"
endchoice

config BOARD_PLATFORM
    string
    default "nuttx" if PLATFORM_NUTTX

config BOARD_TOOLCHAIN
    string "Toolchain"
    default ""

config BOARD_ARCHITECTURE
    string "Architecture"
    default ""

config NUTTX_CONFIG
    string "nuttx defconfig"
    default "nsh" if PLATFORM_NUTTX

menu "Tarox modules"

config MODULES_BLDC
    bool "bldc built-in app"
    default n
    help
      Builds src/modules/bldc when enabled in this board .taroxconfig.
      Requires NuttX CONFIG_PWM_MULTICHAN, TIM1 PWM, and board BLDC setup.

endmenu

menu "Tarox drivers"

config DRIVERS_AS5600
    bool "as5600 encoder driver"
    default n
    help
      Builds src/drivers/as5600 as a uORB publisher for encoder_angle.

config DRIVERS_PWM_OUT
    bool "pwm_out actuator output driver"
    default n
    help
      Builds src/drivers/pwm_out as a uORB actuator_phase_duty consumer.

endmenu
